#!/bin/bash
EXERCISE_DIR="/workspace/exercise"
ACTIVITIES_IMPL="$EXERCISE_DIR/src/main/kotlin/fulfillment/FulfillmentActivitiesImpl.kt"
WORKFLOW_IMPL="$EXERCISE_DIR/src/main/kotlin/fulfillment/FulfillmentWorkflowImpl.kt"

fail() { echo "FAIL: $1"; exit 1; }
pass() { echo "PASS: $1"; }

if grep -q "TODO(" "$ACTIVITIES_IMPL"; then
  fail "FulfillmentActivitiesImpl still has unimplemented stubs (TODO(...) found). Implement all three activity methods."
fi
pass "Activity stubs replaced"

if ! grep -q "ApplicationFailure" "$ACTIVITIES_IMPL"; then
  fail "FulfillmentActivitiesImpl should use ApplicationFailure.newFailure() for error cases, not raw exception throws."
fi
pass "ApplicationFailure used in activities"

if ! grep -q "Workflow.newActivityStub" "$WORKFLOW_IMPL"; then
  fail "FulfillmentWorkflowImpl is missing Workflow.newActivityStub(...). Create a FulfillmentActivities stub."
fi
pass "Activity stub created in workflow"

if ! grep -q "setStartToCloseTimeout\|StartToCloseTimeout" "$WORKFLOW_IMPL"; then
  fail "FulfillmentWorkflowImpl is missing a StartToCloseTimeout on the ActivityOptions."
fi
pass "StartToCloseTimeout configured"

if grep -q "TODO(" "$WORKFLOW_IMPL"; then
  fail "FulfillmentWorkflowImpl.processOrder() is still unimplemented. Call the activities and return an OrderResult."
fi
pass "processOrder returns a result"

echo "Running gradle compileKotlin..."
cd "$EXERCISE_DIR"
if ! gradle compileKotlin -q 2>&1; then
  fail "Project does not compile. Fix any compilation errors above and try again."
fi
pass "Project compiles successfully"

echo ""
echo "All checks passed! Run the worker and starter to see durable execution in action."
